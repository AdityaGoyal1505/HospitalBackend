# ==========================================
# Hospital API Environment Variables Template
# ==========================================

# Spring Profile ('prod' for production with WhatsApp Cloud API, 'local' for local testing)
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hospital_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=5

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# Security & Secrets
HOSPITAL_OTP_HMAC_SECRET=your_32_byte_or_stronger_hmac_secret
HOSPITAL_JWT_SECRET_BASE64=your_base64_encoded_32_byte_jwt_secret
HOSPITAL_JWT_EXPIRATION_SECONDS=3600
HOSPITAL_JWT_ISSUER=hospital-api

# Meta WhatsApp Cloud API (Required when profile is not 'local')
WHATSAPP_API_BASE_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v26.0
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_OTP_TEMPLATE_NAME=hospital_otp_verification
WHATSAPP_API_TEMPLATE_LANGUAGE=en_US

# Twilio SMS (Optional fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Document Storage
DOCUMENT_STORAGE_DIR=/var/hospital/private-storage/documents
APP_DOCUMENTS_MAX_SIZE_BYTES=5242880

# Push Notifications
APP_PUSH_ENABLED=false

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SECURITY=INFO
LOGGING_LEVEL_OAUTH2=INFO
LOGGING_LEVEL_WEB=INFO
